{
  "name": "codex-search-bridge",
  "version": "0.2.0",
  "description": "Verified Codex live-web research for tool-capable external models.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Zhao73",
    "url": "https://github.com/Zhao73"
  },
  "homepage": "https://github.com/Zhao73/codex-search-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhao73/codex-search-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Zhao73/codex-search-bridge/issues"
  },
  "keywords": [
    "codex",
    "mcp",
    "model-context-protocol",
    "web-search",
    "local-llm",
    "research",
    "claude-code"
  ],
  "bin": {
    "codex-search-bridge": "dist/server.mjs"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run render:assets && tsup && node scripts/build-plugin.mjs",
    "prepublishOnly": "npm run build",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node plugins/codex-search-bridge/dist/server.mjs --doctor",
    "render:assets": "node scripts/render-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "cross-spawn": "7.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.1.1",
    "sharp": "0.35.3",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "esbuild": "0.28.1"
  }
}
