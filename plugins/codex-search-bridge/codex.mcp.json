{
  "mcpServers": {
    "codex-search-bridge": {
      "command": "node",
      "args": [
        "./dist/server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "OPENAI_API_KEY",
        "OPENAI_ORG_ID",
        "OPENAI_PROJECT_ID",
        "OPENAI_BASE_URL",
        "CODEX_SEARCH_BRIDGE_CODEX_BIN",
        "CODEX_SEARCH_BRIDGE_CLAUDE_BIN",
        "CODEX_SEARCH_BRIDGE_PROVIDER",
        "CODEX_SEARCH_BRIDGE_MODEL",
        "CODEX_SEARCH_BRIDGE_CLI_ONLY",
        "TAVILY_API_KEY"
      ]
    }
  }
}
